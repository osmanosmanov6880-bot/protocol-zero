# Local development does not require this file (npm start).
# For production: PUBLIC_URL must be your real HTTPS origin.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_URL=https://your-domain.example
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_96_RANDOM_HEX_CHARACTERS
# For docker-compose, DB_PATH is set by compose.
# Optional actual advertising platform (leave empty until verified):
PLATFORM_NAME=
PLATFORM_URL=
# Only configure once a trusted platform sends signed completion events.
PLATFORM_WEBHOOK_SECRET=

# Conversion Bridge v2: JSON array with 0..7 confirmed integrations.
# Copy config/platforms.example.json to a private operator-managed file,
# update ONLY with verified platform capabilities and real HTTPS URL,
# then mount the file into your container or point to it on the host.
# PZ_PLATFORMS_FILE=/app/config/platforms.live.json
# Secrets are never kept in JSON: configure the env variable named in secretEnv.
# PZ_REAL_PRODUCT_ONE_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
# Sandbox is launched separately by START_DEMO_WINDOWS.cmd and is prohibited in production.
